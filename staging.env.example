DEPLOY_ENV=staging
# Staging is published through a Cloudflare Tunnel, and Spexify's API and Spexflix's and Spexgram's media through
# Tailscale Funnel;
# production uses neither
COMPOSE_FILE=compose.yaml:compose.tunnel.yaml:compose.staging.yaml:compose.tailnet.yaml
# The Cloudflare Tunnel connector's image tag, pinned; upgrade it deliberately
CLOUDFLARED_VERSION=2026.10.1

ANALYTICS_HOST=analytics-staging.example.org
KEYCLOAK_HOST=auth-staging.example.org
MAIL_HOST=mail-staging.example.org

SPEXREGISTER_NAME="Spexregister (staging)"
SPEXREGISTER_WEB_HOST=register-staging.example.org
SPEXREGISTER_API_HOST=register-api-staging.example.org
FGV_REVIVAL_NAME="Nyuppsättning (staging)"
FGV_REVIVAL_WEB_HOST=revival-staging.example.org
FGV_REVIVAL_API_HOST=revival-api-staging.example.org
SPEXIFY_NAME="Spexify (staging)"
SPEXIFY_WEB_HOST=spexify-staging.example.org
SPEXFLIX_NAME="Spexflix (staging)"
SPEXFLIX_WEB_HOST=spexflix-staging.example.org
SPEXGRAM_NAME="Spexgram (staging)"
SPEXGRAM_WEB_HOST=spexgram-staging.example.org
ARCHIVE_NAME="Spexarkivet (staging)"
ARCHIVE_WEB_HOST=archive-staging.example.org
# Spexify's API and Spexflix's and Spexgram's media servers join the tailnet (compose.tailnet.yaml) as
# spexify-api-staging, spexflix-media-staging and spexgram-media-staging, with this tag, and are published with Funnel; the edge proxy (compose.edge.yaml) is for
# production
TAILNET_TAG=tag:fgv-staging
TAILSCALE_IMAGE=tailscale/tailscale:v1.104.1

KEYCLOAK_IMAGE=bloomper/fgv-keycloak:develop
MYSQL_IMAGE=mysql:8.4
UMAMI_IMAGE=ghcr.io/umami-software/umami:3.4
POSTGRES_IMAGE=postgres:17-alpine

KEYCLOAK_MYSQL_DATABASE=keycloak
KEYCLOAK_MYSQL_USER=keycloak

UMAMI_POSTGRES_DATABASE=umami
UMAMI_POSTGRES_USER=umami

KEYCLOAK_REALM=fgv
KEYCLOAK_ADMIN=admin
ADMIN_NOTIFICATION_RECIPIENTS=admin@example.org
KEYCLOAK_THEME=FGV
TURNSTILE_SITE_KEY=

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_USER=
SMTP_STARTTLS=false
SMTP_SSL=false
MAIL_FROM=noreply@example.org
