DEPLOY_ENV=staging
# Staging is published through a Cloudflare Tunnel; production uses no Cloudflare
COMPOSE_FILE=compose.yaml:compose.tunnel.yaml:compose.staging.yaml

ANALYTICS_HOST=analytics-staging.example.org
KEYCLOAK_HOST=auth-staging.example.org
MAIL_HOST=mail-staging.example.org

SPEXREGISTER_NAME="Spexregister (staging)"
SPEXREGISTER_WEB_HOST=register-staging.example.org
SPEXREGISTER_API_HOST=register-api-staging.example.org
FGV_REVIVAL_NAME="Nyuppsättning (staging)"
FGV_REVIVAL_WEB_HOST=revival-staging.example.org
FGV_REVIVAL_API_HOST=revival-api-staging.example.org
SPEXIFY_NAME="Spexify (staging)"
SPEXIFY_WEB_HOST=spexify-staging.example.org
SPEXFLIX_NAME="Spexflix (staging)"
SPEXFLIX_WEB_HOST=spexflix-staging.example.org
# The edge proxy (compose.edge.yaml): DNS-only hostnames served straight from this host, with Let's Encrypt
SPEXIFY_API_HOST=spexify-api-staging.example.org
SPEXFLIX_MEDIA_HOST=spexflix-media-staging.example.org
ACME_EMAIL=admin@example.org

KEYCLOAK_IMAGE=bloomper/fgv-keycloak:develop
MYSQL_IMAGE=mysql:8.4
UMAMI_IMAGE=ghcr.io/umami-software/umami:3.4
POSTGRES_IMAGE=postgres:17-alpine

KEYCLOAK_MYSQL_DATABASE=keycloak
KEYCLOAK_MYSQL_USER=keycloak

UMAMI_POSTGRES_DATABASE=umami
UMAMI_POSTGRES_USER=umami

KEYCLOAK_REALM=fgv
KEYCLOAK_ADMIN=admin
ADMIN_NOTIFICATION_RECIPIENTS=admin@example.org
KEYCLOAK_THEME=FGV
TURNSTILE_SITE_KEY=

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_USER=
SMTP_STARTTLS=false
SMTP_SSL=false
MAIL_FROM=noreply@example.org
