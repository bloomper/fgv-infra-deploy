DEPLOY_ENV=production
COMPOSE_FILE=compose.yaml:compose.tunnel.yaml

ANALYTICS_HOST=register-analytics.example.org
KEYCLOAK_HOST=register-auth.example.org

SPEXREGISTER_NAME=Spexregister
SPEXREGISTER_WEB_HOST=register.example.org
SPEXREGISTER_API_HOST=register-api.example.org
FGV_REVIVAL_NAME="Nyuppsättning"
FGV_REVIVAL_WEB_HOST=revival.example.org
FGV_REVIVAL_API_HOST=revival-api.example.org

KEYCLOAK_IMAGE=bloomper/fgv-keycloak:1.1.0
MYSQL_IMAGE=mysql:8.4
UMAMI_IMAGE=ghcr.io/umami-software/umami:3.4.0
POSTGRES_IMAGE=postgres:17-alpine
CLOUDFLARED_VERSION=2026.10.0

KEYCLOAK_MYSQL_DATABASE=keycloak
KEYCLOAK_MYSQL_USER=keycloak

UMAMI_POSTGRES_DATABASE=umami
UMAMI_POSTGRES_USER=umami

KEYCLOAK_REALM=fgv
KEYCLOAK_ADMIN=admin
ADMIN_NOTIFICATION_RECIPIENTS=admin@example.org
KEYCLOAK_THEME=FGV
TURNSTILE_SITE_KEY=

SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_AUTH=true
SMTP_USER=noreply@example.org
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_FROM=noreply@example.org
